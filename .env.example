# Copy to .env.local (or set in your service manager) when hosting the app.
# Leave everything empty for local use on your own laptop.

# Password for the web UI. Required if the app is reachable from the internet,
# because the app runs submitted Java code.
APP_PASSWORD=

# Secret for scripts / Claude to call the API with "Authorization: Bearer <API_TOKEN>".
# Generate one with:  openssl rand -hex 32
API_TOKEN=

# Folder for the SQLite database (default: ./data). Put it on persistent disk.
# DATA_DIR=/var/lib/java-prep

# Run submitted code inside a locked-down Docker container (recommended on a server).
# JAVA_SANDBOX=docker
# JAVA_SANDBOX_IMAGE=eclipse-temurin:21-jdk
